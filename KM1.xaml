  <Color x:Key="SystemAccentColorDark1">#FF10218B</Color>
  <Color x:Key="SystemAccentColorDark2">#FF10218B</Color>
  <Color x:Key="SystemAccentColorDark3">#FF0C1A6E</Color>
  <Color x:Key="SystemAccentColorLight1">#FF4A5FE0</Color>
  <Color x:Key="SystemAccentColorLight2">#FF3A4FD1</Color>
  <Color x:Key="SystemAccentColorLight3">#FF99A6FF</Color>

  <!-- 角丸 / Corner radius -->
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>

